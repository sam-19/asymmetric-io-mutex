{
  "name": "asymmetric-io-mutex",
  "version": "1.0.0",
  "description": "Shared array buffer mutex with asymmetric, configurable input and output buffers",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "release": "npm publish --access=public",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --coverage"
  },
  "keywords": [],
  "author": "Sampsa Lohi",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "typescript": "5.6",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@stdlib/constants-float32": "^0.0.6",
    "scoped-event-log": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-19/asymmetric-io-mutex.git"
  },
  "bugs": {
    "url": "https://github.com/sam-19/asymmetric-io-mutex/issues"
  },
  "homepage": "https://github.com/sam-19/asymmetric-io-mutex#readme"
}
